<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_background"
    android:orientation="vertical">

    <include layout="@layout/layout_view_titlebar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/bg_color_ffe6e7e8"
                android:orientation="vertical"
                android:paddingLeft="@dimen/common_page_left_right_space"
                android:paddingTop="@dimen/dimens_dp_10"
                android:paddingRight="@dimen/common_page_left_right_space"
                android:paddingBottom="@dimen/dimens_dp_10">

                <TextView
                    android:id="@+id/tv_fingerprint_ic_card_add_config_tips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingMultiplier="1.2"
                    android:text="@string/add_fingerprint_tips"
                    android:textColor="@color/text_color_ff0f1110"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                style="@style/list_item_overall"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_ic_card_bluetooth_config_name"
                    style="@style/list_item_title"
                    android:text="@string/fingerprint_user_name" />

                <EditText
                    android:id="@+id/et_ic_card_bluetooth_config_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="left|center_vertical"
                    android:hint="@string/fingerprint_name_hint"
                    android:imeOptions="actionDone"
                    android:maxLength="20"
                    android:maxLines="1"
                    android:paddingTop="14dp"
                    android:singleLine="true"
                    android:textColor="@color/text_gray_dark"
                    android:textColorHint="@color/text_gray_light"
                    android:textSize="16sp" />

            </LinearLayout>

            <include layout="@layout/layout_view_line" />

            <LinearLayout
                android:id="@+id/ll_ic_card_bluetooth_config_remarks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/list_item_overall"
                    android:orientation="vertical">

                    <TextView
                        style="@style/list_item_title"
                        android:text="@string/remarks" />

                    <EditText
                        android:id="@+id/et_ic_card_bluetooth_config_remarks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:gravity="left|center_vertical"
                        android:hint="@string/fingerprint_remarks_hint"
                        android:imeOptions="actionDone"
                        android:maxLength="20"
                        android:maxLines="1"
                        android:paddingTop="14dp"
                        android:singleLine="true"
                        android:textColor="@color/text_gray_dark"
                        android:textColorHint="@color/text_gray_light"
                        android:textSize="16sp" />

                </LinearLayout>

                <include layout="@layout/layout_view_line" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/list_item_overall"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        style="@style/list_item_title"
                        android:text="@string/valid_period" />

                    <RadioGroup
                        android:id="@+id/rg_valid_period"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rb_valid_period_permanent"
                            style="@style/radio_btn_key_pwd"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="@dimen/dimens_dp_20"
                            android:layout_weight="1"
                            android:checked="true"
                            android:minHeight="30dp"
                            android:text="@string/pwd_type_name_permanent" />

                        <RadioButton
                            android:id="@+id/rb_valid_period_time_limited"
                            style="@style/radio_btn_key_pwd"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="30dp"
                            android:text="@string/pwd_type_name_time_limited" />

                    </RadioGroup>

                </LinearLayout>

                <include layout="@layout/layout_view_line" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_ic_card_bluetooth_config_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_device_current_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/bg_color_ffe6e7e8"
                    android:lineSpacingMultiplier="1.2"
                    android:orientation="vertical"
                    android:paddingLeft="@dimen/common_page_left_right_space"
                    android:paddingTop="@dimen/dimens_dp_10"
                    android:paddingRight="@dimen/common_page_left_right_space"
                    android:paddingBottom="@dimen/dimens_dp_10"
                    android:text="@string/device_current_date"
                    android:textColor="@color/text_color_ffb1b3b6"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/ll_start_time"
                    style="@style/list_item_overall"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        style="@style/list_item_title"
                        android:text="@string/start_time" />

                    <TextView
                        android:id="@+id/tv_ic_card_bluetooth_config_start_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="left|center_vertical"
                        android:paddingTop="14dp"
                        android:textColor="@color/common_text_color"
                        android:textSize="14sp" />

                </LinearLayout>

                <include layout="@layout/layout_view_line" />

                <LinearLayout
                    android:id="@+id/ll_end_time"
                    style="@style/list_item_overall"
                    android:orientation="vertical">

                    <TextView
                        style="@style/list_item_title"
                        android:text="@string/end_time" />

                    <TextView
                        android:id="@+id/tv_ic_card_bluetooth_config_end_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="left|center_vertical"
                        android:paddingTop="14dp"
                        android:textColor="@color/common_text_color"
                        android:textSize="14sp" />

                </LinearLayout>

                <include layout="@layout/layout_view_line" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_ic_card_bluetooth_config_next"
                style="@style/btn_style_main"
                android:layout_margin="16dp"
                android:enabled="false"
                android:text="@string/create_key" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </ScrollView>

</androidx.appcompat.widget.LinearLayoutCompat>