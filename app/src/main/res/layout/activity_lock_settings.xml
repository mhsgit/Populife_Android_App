<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/layout_view_titlebar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/ll_lock_settings_lock_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/list_item_overall">

                    <TextView
                        style="@style/list_item_title"
                        android:text="@string/device_name" />

                    <TextView
                        android:id="@+id/tv_lock_settings_lock_name"
                        style="@style/list_item_description" />

                    <ImageView
                        android:id="@+id/tv_lock_settings_lock_name_more"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/arrow_go_to_light_grey" />

                </LinearLayout>

                <include layout="@layout/layout_view_line" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_serial_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/list_item_overall">

                    <TextView
                        style="@style/list_item_title"
                        android:text="@string/serial_number" />

                    <TextView
                        android:id="@+id/tv_lock_settings_serial_number"
                        style="@style/list_item_description" />

                </LinearLayout>

                <include layout="@layout/layout_view_line" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_lock_settings_mac_id"
                style="@style/list_item_overall"
                android:visibility="gone">

                <TextView
                    style="@style/list_item_title"
                    android:text="@string/mac_id" />

                <TextView
                    android:id="@+id/tv_lock_settings_mac_id"
                    style="@style/list_item_description" />

                <ImageView
                    android:id="@+id/iv_lock_settings_mac_display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_mac_display" />

            </LinearLayout>

            <include
                layout="@layout/layout_view_line"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/list_item_overall">

                    <TextView
                        style="@style/list_item_title"
                        android:text="@string/battery" />

                    <include layout="@layout/layout_space_horizontal" />

                    <ImageView
                        android:id="@+id/iv_lock_settings_battery_sync"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/refresh_icon" />

                    <ImageView
                        android:id="@+id/iv_lock_settings_battery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_marginRight="4dp"
                        android:src="@drawable/ic_battery_100"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_lock_settings_battery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:text="@string/hundred_percent"
                        android:textColor="@color/text_gray_medium"
                        android:textSize="16sp" />

                </LinearLayout>

                <include layout="@layout/layout_view_line" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/list_item_overall">

                    <TextView
                        style="@style/list_item_title"
                        android:text="@string/dependent_space" />

                    <TextView
                        android:id="@+id/tv_lock_settings_space"
                        style="@style/list_item_description" />

                    <ImageView
                        android:id="@+id/tv_lock_settings_space_more"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/arrow_go_to_light_grey" />

                </LinearLayout>

                <include layout="@layout/layout_view_line" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_lock_settings_validity_period"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout style="@style/list_item_overall">

                        <TextView
                            style="@style/list_item_title"
                            android:text="@string/validity_period" />

                        <TextView
                            android:id="@+id/tv_lock_settings_validity_period"
                            style="@style/list_item_description" />

                    </LinearLayout>

                </LinearLayout>

                <include layout="@layout/layout_view_line" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_lock_settings_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/list_item_overall">

                    <TextView
                        style="@style/list_item_title"
                        android:text="@string/start_time" />

                    <TextView
                        android:id="@+id/tv_lock_settings_start_time"
                        style="@style/list_item_description" />

                </LinearLayout>

                <include layout="@layout/layout_view_line" />

                <LinearLayout style="@style/list_item_overall">

                    <TextView
                        style="@style/list_item_title"
                        android:text="@string/end_time" />

                    <TextView
                        android:id="@+id/tv_lock_settings_end_time"
                        style="@style/list_item_description" />

                </LinearLayout>

                <include layout="@layout/layout_view_line" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_lock_settings_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/list_item_overall">

                    <TextView
                        style="@style/list_item_title"
                        android:text="@string/key_status" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tv_key_status"
                        style="@style/list_item_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <include layout="@layout/layout_view_line" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_lock_settings_admin_passcode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/list_item_overall">

                    <TextView
                        style="@style/list_item_title"
                        android:text="@string/admin_password" />

                    <TextView
                        android:id="@+id/tv_lock_settings_admin_passcode"
                        style="@style/list_item_description" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/arrow_go_to_light_grey" />

                </LinearLayout>

                <include layout="@layout/layout_view_line" />

            </LinearLayout>

            <Space
                android:id="@+id/space_lock_settings_lock_time"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <LinearLayout
                android:id="@+id/ll_lock_settings_show_lock_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/list_item_overall">

                    <TextView
                        style="@style/list_item_title"
                        android:layout_height="58dp"
                        android:clickable="true"
                        android:gravity="center"
                        android:text="@string/device_time" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tv_read_lock_time"
                        style="@style/list_item_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <include layout="@layout/layout_view_line" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_lock_settings_lock_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/list_item_overall">

                    <TextView
                        style="@style/list_item_title"
                        android:layout_height="58dp"
                        android:clickable="true"
                        android:gravity="center"
                        android:text="@string/adjus_lock_time" />

                    <ImageView
                        android:id="@+id/iv_lock_settings_lock_time_help"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:paddingLeft="6dp"
                        android:paddingTop="18dp"
                        android:paddingRight="30dp"
                        android:paddingBottom="18dp"
                        android:src="@drawable/help_icon" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/arrow_go_to_light_grey" />

                </LinearLayout>

                <include layout="@layout/layout_view_line" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_lock_settings_auto_locking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/list_item_overall">

                    <TextView
                        style="@style/list_item_title"
                        android:text="@string/automatic_locking" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tv_auto_locking"
                        style="@style/list_item_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:src="@drawable/arrow_go_to_light_grey" />

                </LinearLayout>

                <include layout="@layout/layout_view_line" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_lock_settings_remote_unlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/list_item_overall">

                    <TextView
                        style="@style/list_item_title"
                        android:text="@string/unlock_remotely" />

                    <TextView
                        android:id="@+id/tv_lock_settings_remote_unlock_state"
                        style="@style/list_item_description" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/arrow_go_to_light_grey" />

                </LinearLayout>

                <include layout="@layout/layout_view_line" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_lock_settings_lock_update"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout style="@style/list_item_overall">

                    <TextView
                        style="@style/list_item_title"
                        android:text="@string/lock_update" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/arrow_go_to_light_grey" />

                </LinearLayout>

                <include layout="@layout/layout_view_line" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_lock_settings_keypad_volume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/list_item_overall">

                    <TextView
                        style="@style/list_item_title"
                        android:text="@string/lock_sound" />

                    <TextView
                        android:id="@+id/tv_lock_settings_keypad_volume"
                        style="@style/list_item_description" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/arrow_go_to_light_grey" />

                </LinearLayout>

                <include layout="@layout/layout_view_line" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_lock_settings_delete"
                style="@style/btn_style_main"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="40dp"
                android:layout_marginRight="24dp"
                android:layout_marginBottom="40dp"
                android:text="@string/delete" />

        </LinearLayout>

    </ScrollView>

</androidx.appcompat.widget.LinearLayoutCompat>
