<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/help_win_bg2"
    android:layout_width="280dp"
    android:orientation="horizontal"
    android:padding="10dp"
    android:gravity="center"
    android:layout_height="92dp">

    <TextView
        android:id="@+id/tv_lan_english"
        android:layout_gravity="center"
        android:layout_marginLeft="10dp"
        android:drawableTop="@drawable/lan_english"
        android:text="@string/language_english"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_weight="1"
        android:drawablePadding="@dimen/dimens_dp_10"
        android:textColor="@color/common_text_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/tv_lan_chinese"
        android:layout_gravity="center"
        android:layout_marginLeft="10dp"
        android:layout_weight="1"
        android:drawableTop="@drawable/lan_chinese"
        android:text="@string/language_simplified_chinese"
        android:textSize="14sp"
        android:drawablePadding="@dimen/dimens_dp_10"
        android:textColor="@color/common_text_color"
        android:layout_width="wrap_content"
        android:gravity="center"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/tv_language_japanese"
        android:layout_gravity="center"
        android:layout_marginLeft="10dp"
        android:layout_weight="1"
        android:gravity="center"
        android:drawableTop="@drawable/lan_japanese"
        android:text="@string/language_japanese"
        android:textSize="14sp"
        android:drawablePadding="@dimen/dimens_dp_10"
        android:textColor="@color/common_text_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

</LinearLayout>
