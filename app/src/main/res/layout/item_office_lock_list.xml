<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="80dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_page_left_right_space"
        android:layout_marginTop="@dimen/dimens_dp_10"
        android:layout_marginRight="@dimen/common_page_left_right_space"
        android:layout_marginBottom="@dimen/dimens_dp_10"
        android:gravity="center_vertical">

        <TextView
            android:layout_alignParentTop="true"
            android:layout_centerVertical="true"
            android:id="@+id/tv_item_gateway_binded_lock_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/name"
            android:textColor="@color/common_text_color"
            android:textSize="16sp" />


        <TextView
            android:layout_centerVertical="true"
            android:layout_alignParentRight="true"
            android:id="@+id/tv_lock_settings_sync"
            style="@style/btn_style_main"
            android:padding="8dp"
            android:minWidth="60dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sync" />

    </RelativeLayout>

</androidx.appcompat.widget.LinearLayoutCompat>
