<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/common_page_title_bar_height"
        android:gravity="center_vertical"
        android:visibility="gone">

        <RelativeLayout
            android:id="@+id/page_back"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:onClick="finishCurrentActivity"
            android:paddingLeft="@dimen/common_page_left_right_space"
            android:paddingRight="8dp">

            <ImageButton
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_centerVertical="true"
                android:background="@null"
                android:onClick="finishCurrentActivity"
                android:src="@drawable/ic_back" />

        </RelativeLayout>

        <TextView
            android:id="@+id/page_action"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:background="@null"
            android:gravity="center"
            android:paddingRight="@dimen/common_page_left_right_space"
            android:text="@string/page_action"
            android:textColor="@color/sign_page_action_text"
            android:textSize="@dimen/sign_page_action_text" />

    </RelativeLayout>

    <TextView
        android:id="@+id/page_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/common_page_left_right_space"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/page_title"
        android:textColor="@color/sign_page_title_text"
        android:textSize="@dimen/sign_page_title_text"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="36dp"
        android:layout_marginBottom="36dp"
        android:src="@drawable/img_splash_1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/common_page_left_right_space">


        <com.populstay.populife.ui.widget.exedittext.ExEditText
            android:id="@+id/et_sign_user_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:hint="@string/user_name_edit_hint"
            app:inputType="account" />

        <com.populstay.populife.ui.widget.exedittext.ExEditText
            android:id="@+id/et_sign_pwd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:hint="@string/password"
            app:inputType="password"
            app:label="@string/password"
            app:maxLength="20" />

        <com.populstay.populife.ui.widget.exedittext.ExEditText
            android:id="@+id/et_confirm_pwd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:hint="@string/confirm_password"
            app:inputType="password"
            app:label="@string/confirm_password"
            app:maxLength="20" />

        <com.populstay.populife.ui.widget.exedittext.ExEditText
            android:id="@+id/et_sign_verification_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:hint="@string/verification_code"
            app:inputType="verificationCode"
            app:label="@string/verification_code"
            app:maxLength="6" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_switch_sign_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/common_edit_text_margin_top"
                android:layout_marginRight="5dp"
                android:layout_toLeftOf="@id/tv_forget_pwd"
                android:padding="8dp"
                android:text="@string/sign_in_by_verify_code"
                android:textColor="#FF212322"
                android:textSize="14sp" />


            <TextView
                android:id="@+id/tv_forget_pwd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/common_edit_text_margin_top"
                android:padding="8dp"
                android:text="@string/forgot_pwd"
                android:textColor="#FF212322"
                android:textSize="14sp" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_user_terms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/common_edit_text_margin_top">

            <CheckBox
                android:id="@+id/cb_sign_user_terms"
                style="@style/user_terms_confirm_check_box"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:layout_marginLeft="0dp"
                android:layout_marginTop="0dp"
                android:layout_marginRight="10dp"
                android:text="@null" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/cb_sign_user_terms"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvAgree2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/read_and_agree"
                    android:textColor="#FF212322"
                    android:clickable="false"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvAgree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/user_terms_privacy_policy"
                    android:textColor="#ee2737"
                    android:visibility="gone"
                    android:textSize="14sp" />

                <!--                <TextView-->
                <!--                    android:layout_width="wrap_content"-->
                <!--                    android:layout_height="wrap_content"-->
                <!--                    android:text="@string/and"-->
                <!--                    android:textColor="#FF212322"-->
                <!--                    android:textSize="14sp" />-->

                <!--                <TextView-->
                <!--                    android:id="@+id/tvPolicy"-->
                <!--                    android:layout_width="wrap_content"-->
                <!--                    android:layout_height="wrap_content"-->
                <!--                    android:text="@string/privacy_policy"-->
                <!--                    android:textColor="#ee2737"-->
                <!--                    android:textSize="14sp" />-->

            </LinearLayout>

        </RelativeLayout>

        <TextView
            android:id="@+id/tv_sign_action_btn"
            style="@style/btn_style_main"
            android:layout_marginTop="@dimen/sign_action_btn_margin_top"
            android:background="@drawable/selector_btn_main"
            android:enabled="false"
            android:text="@string/sign_in" />

        <LinearLayout
            android:id="@+id/ll_sign_in_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/already_registered"
                android:textColor="@color/common_text_color"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_goto_sign_in"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="@string/click_goto_login"
                android:textColor="#EE2737"
                android:textSize="14sp" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/ll_sign_up_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="30dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="0.5dp"
                    android:layout_weight="1"
                    android:background="@color/gray_line" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dimens_dp_20"
                    android:layout_marginRight="@dimen/dimens_dp_20"
                    android:text="@string/or"
                    android:textColor="@color/color_ffcccdcd"
                    android:textSize="16sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0.5dp"
                    android:layout_weight="1"
                    android:background="@color/gray_line" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_sign_up_action_btn"
                style="@style/btn_style_main"
                android:background="@drawable/selector_bg_stroke"
                android:text="@string/create_an_account"
                android:textColor="@color/common_text_color" />

        </LinearLayout>

        <include layout="@layout/layout_space_vertical" />


        <LinearLayout
            android:id="@+id/ll_switch_language"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/language" />

            <TextView
                android:id="@+id/tv_switch_language"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:drawableRight="@drawable/arrow_up"
                android:drawablePadding="5dp"
                android:padding="8dp"
                android:text="@string/switch_language"
                android:textColor="#FF212322"
                android:textSize="16sp" />

        </LinearLayout>


    </LinearLayout>

</LinearLayout>