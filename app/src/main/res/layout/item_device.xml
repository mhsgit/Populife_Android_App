<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/selector_bg_white_gray"
        android:gravity="center_vertical"
        android:paddingLeft="@dimen/common_page_left_right_space"
        android:paddingTop="16dp"
        android:paddingRight="@dimen/common_page_left_right_space"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tv_item_device_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/name"
            android:textColor="@color/common_text_color"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_item_device_paired"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/paired"
            android:textColor="@color/text_gray_light"
            android:textSize="16sp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/iv_item_device_add_mark"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_add"
            android:visibility="visible"
            app:tint="@color/common_text_color" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <View
        android:id="@+id/bottom_line_view"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/gray_line" />

</LinearLayout>