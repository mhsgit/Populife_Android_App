<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/common_page_left_right_space"
    android:layout_marginTop="@dimen/common_page_left_right_space"
    android:layout_marginRight="@dimen/common_page_left_right_space"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/dimens_dp_10"
    app:cardElevation="@dimen/dimens_dp_6"
    app:contentPaddingBottom="@dimen/dimens_dp_20"
    app:contentPaddingLeft="@dimen/dimens_dp_20"
    app:contentPaddingRight="@dimen/dimens_dp_20">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimens_dp_20"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/iv_type_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentTop="true"
                    android:src="@drawable/ic_card_icon" />

                <com.populstay.populife.ui.widget.extextview.ExTextView
                    android:id="@+id/tv_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dimens_dp_10"
                    android:layout_toRightOf="@id/iv_type_icon"
                    android:ellipsize="end"
                    android:lines="1"
                    android:singleLine="true"
                    android:text="@string/app_name"
                    android:textColor="@color/common_text_color"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tv_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/tv_name"
                    android:layout_alignParentRight="true"
                    android:layout_marginLeft="@dimen/dimens_dp_10"
                    android:layout_toRightOf="@+id/tv_name"
                    android:gravity="right"
                    android:text="1111111111"
                    android:textColor="@color/text_color_ffb1b3b6"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_type_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_name"
                    android:layout_alignLeft="@+id/tv_name"
                    android:layout_marginTop="4dp"
                    android:gravity="left"
                    android:text="1111111111"
                    android:textColor="@color/text_color_ffee2737"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/ll_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_type_name"
                    android:layout_alignLeft="@+id/tv_name"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/ll_time_range"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_start_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="left"
                            android:text="2020-08-06 15:25:05"
                            android:textColor="@color/text_color_ffb1b3b6"
                            android:textSize="12sp" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:src="@drawable/arrow_right_icon" />

                        <TextView
                            android:id="@+id/tv_end_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="right"
                            android:text="2020-08-06 15:25:05"
                            android:textColor="@color/text_color_ffb1b3b6"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_single_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="left"
                        android:textColor="@color/text_color_ffb1b3b6"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_pwd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignWithParentIfMissing="true"
                    android:layout_below="@+id/ll_time"
                    android:layout_alignLeft="@+id/tv_name"
                    android:layout_marginTop="14dp"
                    android:gravity="left"
                    android:text="45465465465"
                    android:textColor="@color/common_text_color"
                    android:textSize="22sp" />

                <ImageView
                    android:id="@+id/iv_warning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignTop="@+id/tv_pwd"
                    android:layout_marginLeft="@dimen/dimens_dp_10"
                    android:layout_toRightOf="@+id/tv_pwd"
                    android:padding="5dp"
                    android:src="@drawable/warning_small"
                    android:visibility="gone" />

            </RelativeLayout>


            <LinearLayout
                android:id="@+id/ll_action_btns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:orientation="vertical">

                <include layout="@layout/layout_view_line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dimens_dp_20"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_edit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/edit_icon" />

                    <ImageView
                        android:id="@+id/iv_delete"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="30dp"
                        android:src="@drawable/delete_icon" />

                    <ImageView
                        android:id="@+id/iv_history"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="30dp"
                        android:src="@drawable/history" />

                    <ImageView
                        android:id="@+id/iv_share"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="30dp"
                        android:src="@drawable/send_icon" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <ImageView
            android:id="@+id/iv_admin_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:src="@drawable/admin_tag"
            android:visibility="gone" />

    </FrameLayout>


</androidx.cardview.widget.CardView>

