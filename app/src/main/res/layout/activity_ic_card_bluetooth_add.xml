<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <include layout="@layout/layout_view_titlebar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/activate_device_status_bar" />

            <include layout="@layout/layout_view_line" />

            <TextView
                android:id="@+id/add_device_activate_hint1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/common_page_left_right_space"
                android:layout_marginTop="20dp"
                android:layout_marginRight="@dimen/common_page_left_right_space"
                android:text="@string/adding_fingerprint_hint_1"
                android:textColor="@color/common_text_color"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/iv_add_device_pic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:src="@drawable/fingerprint_add_guide_img" />

            <TextView
                android:id="@+id/add_device_activate_hint2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:layout_marginLeft="@dimen/common_page_left_right_space"
                android:layout_marginTop="20dp"
                android:layout_marginRight="@dimen/common_page_left_right_space"
                android:text="@string/adding_fingerprint_hint_2"
                android:textColor="@color/common_text_color"
                android:textSize="14sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginLeft="@dimen/common_page_left_right_space"
                android:layout_marginTop="30dp"
                android:layout_marginRight="@dimen/common_page_left_right_space"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tv_hint_back"
                    style="@style/btn_style_main"
                    android:layout_width="match_parent" />

                <LinearLayout
                    android:id="@+id/ll_hint_success"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/iv_hint_success"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/dimens_dp_16"
                        android:src="@drawable/icon_circle_successfully"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_hint_success"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/complete_above_operation"
                        android:textColor="@color/white" />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
