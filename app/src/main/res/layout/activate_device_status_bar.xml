<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/dimens_dp_20">


    <ImageView
        android:id="@+id/iv_status_1"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/status_pre_check" />

    <View
        android:id="@+id/line_1"
        android:layout_toRightOf="@+id/iv_status_1"
        android:layout_toLeftOf="@+id/iv_status_2"
        android:layout_width="wrap_content"
        android:layout_height="0.5dp"
        android:layout_centerVertical="true"
        android:background="@color/gray_line"/>

    <ImageView
        android:id="@+id/iv_status_2"
        android:layout_centerInParent="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/status_activate" />

    <View
        android:id="@+id/line_2"
        android:layout_toRightOf="@+id/iv_status_2"
        android:layout_toLeftOf="@+id/iv_status_3"
        android:layout_width="wrap_content"
        android:layout_height="0.5dp"
        android:layout_centerVertical="true"
        android:background="@color/gray_line"/>

    <ImageView
        android:id="@+id/iv_status_3"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/status_pair" />

</RelativeLayout>
