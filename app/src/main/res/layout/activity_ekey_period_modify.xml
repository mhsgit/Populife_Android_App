<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_background"
    android:orientation="vertical">

    <include layout="@layout/layout_view_titlebar" />

    <LinearLayout
        style="@style/list_item_overall"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/list_item_title"
            android:text="@string/valid_period" />

        <RadioGroup
            android:id="@+id/rg_valid_period"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_valid_period_permanent"
                style="@style/radio_btn_key_pwd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/dimens_dp_20"
                android:layout_weight="1"
                android:checked="true"
                android:minHeight="30dp"
                android:text="@string/pwd_type_name_permanent" />

            <RadioButton
                android:id="@+id/rb_valid_period_time_limited"
                style="@style/radio_btn_key_pwd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="30dp"
                android:text="@string/pwd_type_name_time_limited" />

        </RadioGroup>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_time_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_device_current_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_color_ffe6e7e8"
            android:lineSpacingMultiplier="1.2"
            android:orientation="vertical"
            android:paddingLeft="@dimen/common_page_left_right_space"
            android:paddingTop="@dimen/dimens_dp_10"
            android:paddingRight="@dimen/common_page_left_right_space"
            android:paddingBottom="@dimen/dimens_dp_10"
            android:text="@string/device_current_date"
            android:textColor="@color/text_color_ffb1b3b6"
            android:textSize="12sp" />


        <LinearLayout
            style="@style/list_item_overall"
            android:orientation="vertical">

            <TextView
                style="@style/list_item_title"
                android:text="@string/start_time" />

            <LinearLayout
                android:id="@+id/ll_start_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_ekey_period_modify_start_time"
                    style="@style/list_item_description2" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/arrow_go_to_light_grey" />
            </LinearLayout>

        </LinearLayout>

        <include layout="@layout/layout_view_line" />

        <LinearLayout
            style="@style/list_item_overall"
            android:orientation="vertical">

            <TextView
                style="@style/list_item_title"
                android:text="@string/end_time" />

            <LinearLayout
                android:id="@+id/ll_end_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_ekey_period_modify_end_time"
                    style="@style/list_item_description2" />

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/arrow_go_to_light_grey" />

            </LinearLayout>

        </LinearLayout>

        <include layout="@layout/layout_view_line" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_save_btn"
        style="@style/btn_style_main"
        android:layout_marginLeft="@dimen/common_page_left_right_space"
        android:layout_marginTop="@dimen/sign_action_btn_margin_top"
        android:layout_marginRight="@dimen/common_page_left_right_space"
        android:background="@drawable/selector_btn_main"
        android:text="@string/save" />

</androidx.appcompat.widget.LinearLayoutCompat>