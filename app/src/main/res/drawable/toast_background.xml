<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
android:shape="rectangle">
    <!-- 圆角 -->
    <corners android:radius="100dp" /> <!-- 圆角大小，适配不同设备 -->

    <!-- 背景色 -->
    <solid android:color="#CC1A1A1A" /> <!-- 半透明深灰色（模仿系统默认） -->

    <!-- 内边距（可选） -->
    <padding
    android:left="16dp"
    android:top="12dp"
    android:right="16dp"
    android:bottom="12dp"/>

    <!-- 边框（可选） -->
    <stroke
    android:width="1dp"
    android:color="#33FFFFFF"/> <!-- 浅色半透明边框 -->

    <!-- 阴影（Android 5.0+ 生效） -->
    <android:padding
    android:left="2dp"
    android:top="2dp"
    android:right="2dp"
    android:bottom="2dp"/>
</shape>